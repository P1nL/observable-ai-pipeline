# Runtime environment reference. The Python app does NOT auto-load .env.
# Set these variables explicitly in each application process if overriding defaults.
# 0 means disabled for timeout/warning fields, not immediate timeout.
PIPELINE_PROFILE=long-running
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_LEASE_TTL_SECONDS=300
COORDINATOR_SCAN_INTERVAL_SECONDS=5
ATTEMPT_HARD_TIMEOUT_SECONDS=0
TASK_DEADLINE_SECONDS=0
STEP_SOFT_WARNING_SECONDS=21600
TASK_SOFT_WARNING_SECONDS=86400
MAX_ATTEMPTS_PER_RECOVERY_ROUND=3
RETRY_INITIAL_DELAY_SECONDS=10
RETRY_MAX_DELAY_SECONDS=300
# Legacy local/single-executor domain only: 0 or 1 simulated slot.
GPU_PROVIDER=mock
MOCK_GPU_SLOTS=1

# 旧兼容执行域的 CPU 预算；配置节点使用各自 cpu_capacity。未知退出仍占用。
CPU_MAX_CONCURRENCY=2
ARTIFACT_ROOT=./.runtime/artifacts

DATABASE_URL=postgresql://pipeline:pipeline@127.0.0.1:55432/pipeline
PIPELINE_POLL_INTERVAL_SECONDS=0.2
# 仅本地专项启用：故障注入与内部 smoke-v1；正常可新建动画示例或 managed-v1。
ENABLE_TEST_FAULTS=false
# Optional legacy single loopback executor; node pool configuration is below.
# Bundled mock version: 1. Standalone synthetic mock version: independent-mock-v1.
# Blank URL plus an empty node list keeps local-only operation; never switch active job identities.
# Secret must be stable and >=32 characters; never commit a real value.
EXTERNAL_EXECUTOR_URL=
EXTERNAL_EXECUTOR_ID=executor-one
EXTERNAL_EXECUTOR_SECRET=
EXTERNAL_RPC_TIMEOUT_SECONDS=0.5
# Optional preconfigured external nodes; raw JSON array, not a filename.
# See examples/execution-nodes.json. API/all Workers need the same list and secret refs.
# Each service receives only its own secret; never put secret values in this JSON.
# Non-loopback origins require verified HTTPS; optional ca_file is local to the center.
EXECUTION_NODES_JSON=[]
ARTIFACT_STORAGE_ID=pipeline-artifacts
NODE_PROBE_INTERVAL_SECONDS=5
# Node/device capacity is a scheduling limit, not hardware utilization. All compute is CPU MOCK.
# Do not copy long-running timing overrides when selecting the fast-recovery profile.
# Do not put real credentials, model keys or personal material in this file.
